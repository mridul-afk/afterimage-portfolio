# ==========================================
# AFTERIMAGE.EXE - Git Ignore
# ==========================================

# Dependencies
/node_modules
/.pnp
.pnp.*
/.yarn/*
!/.yarn/patches
!/.yarn/plugins
!/.yarn/releases
!/.yarn/versions

# Next.js build files
/.next/
/out/
/build/
/dist/

# Testing and coverage
/coverage/
/test-results/
/playwright-report/

# Environment variables and secrets
.env
.env.*
!.env.example
*.pem
*.key

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# Vercel
.vercel/

# TypeScript
*.tsbuildinfo

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Editor
.vscode/
.idea/
*.swp
*.swo

# Temporary files
*.tmp
*.temp
.cache/
